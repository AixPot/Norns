# Example only; the binary reads environment variables, not .env automatically.
DATABASE_URL=sqlite://norns.sqlite
BIND_ADDR=127.0.0.1:3000
APP_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=true
STATIC_DIR=frontend/dist

# All blank disables attachments; partial configuration is a startup error.
# Server-only credentials; never VITE_* or browser config. No real keys in this file.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ATTACHMENT_MAX_BYTES=16777216
ATTACHMENT_BOARD_QUOTA_BYTES=268435456
